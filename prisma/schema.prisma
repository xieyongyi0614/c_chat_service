model Upload_session {
  id            String @id @default(cuid())
  fileName      String
  fileHash      String
  fileSize      BigInt
  chunkSize     Int
  totalChunks   Int
  uploadedCount Int    @default(0)

  status Int // 0 waiting / 1 uploading / 2 merging / 3 success / -1 fail

  uploaderId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Upload_chunk {
  id         String  @id @default(cuid())
  uploadId   String
  chunkIndex Int
  chunkHash  String?

  createdAt DateTime @default(now())

  @@unique([uploadId, chunkIndex])
}

model File {
  id       String @id @default(cuid())
  fileName String
  fileHash String @unique
  size     BigInt
  url      String

  uploaderId       String
  createdAt        DateTime          @default(now())
  messageHistories Message_history[]

  @@index([fileHash, size])
}
