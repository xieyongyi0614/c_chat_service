// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique // 邮箱
  password        String // 密码
  phone           String?   @unique // 手机号
  nickname        String? // 昵称
  avatar_url      String? // 头像链接
  gender          Int // 性别 `0-女, 1-男, 2-其他`
  state           Int // 账号状态 `-1：注销, 0：正常`
  birthday        DateTime? // 生日
  signature       String? // 个性签名
  location        String? // 地区
  background_wall String? // 背景墙
  update_time     DateTime  @updatedAt // 更新时间
  create_time     DateTime  @default(now()) // 创建时间

  messages                 MessageHistory[] // 消息记录
  // chatRoomParticipants ChatRoomParticipant[] // 聊天室参与者
  conversationParticipants ConversationParticipant[] // 群组拥有者 (可选)
  ownedGroups              Group[]                   @relation("GroupOwner")

  friendUser           Friend[]      @relation("friendUser") // 作为用户的好友关系
  friendFriend         Friend[]      @relation("friendFriend")
  friendApplyRequester FriendApply[] @relation("friendApplyRequester")
  friendApplyResponder FriendApply[] @relation("friendApplyResponder")
  groupMembers         GroupMember[]
  // chatRoomParticipants ChatRoomParticipant[]
}

// ==========================================
// 2. 群组模块 (原 ChatRoom 拆分)
// ==========================================
// 专门存储群聊的公共信息（头像、公告、群名）
model Group {
  id          String   @id @default(cuid())
  name        String // 群名称
  avatar_url  String? // 群头像
  notice      String?  @db.Text // 群公告
  owner_id    String // 群主ID
  state       Int      @default(0) // -1:解散, 0:正常
  update_time DateTime @updatedAt
  create_time DateTime @default(now())

  // 关系
  owner   User          @relation("GroupOwner", fields: [owner_id], references: [id])
  members GroupMember[]

  // 索引：快速查询某人创建的群
  @@index([owner_id])
}

// 群成员表 (原 ChatRoomParticipant)
model GroupMember {
  id          String   @id @default(cuid())
  group_id    String
  user_id     String
  role        Int      @default(2) // 0:群主, 1:管理员, 2:普通成员
  alias       String? // 群昵称
  state       Int      @default(0) // -1:退出/被踢, 0:正常
  update_time DateTime @updatedAt
  create_time DateTime @default(now())

  group Group @relation(fields: [group_id], references: [id])
  user  User  @relation(fields: [user_id], references: [id])

  // 确保一个人在同一个群只有一条记录
  @@unique([group_id, user_id])
  @@index([user_id]) // 查询“我加入了哪些群”
}

// ==========================================
// 3. 会话模块 (核心改动：统一私聊与群聊入口)
// ==========================================
model Conversation {
  id        String @id @default(cuid())
  type      Int // 1: 私聊, 2: 群聊
  // 目标ID：如果是私聊，存对方UserID；如果是群聊，存GroupID
  target_id String

  // 冗余字段：用于聊天列表快速展示，避免连表查最新消息
  last_msg_content String?   @db.Text
  last_msg_time    DateTime?

  update_time DateTime @updatedAt
  create_time DateTime @default(now())

  // 关联
  messages     MessageHistory[]
  participants ConversationParticipant[]
  // 注意：私聊的唯一性建议在代码层控制 (如 A-B 和 B-A 生成同一个 Conversation ID)

  // 索引优化
  @@index([type, target_id])
}

// 会话参与者表 (用于存储：置顶、免打扰、删除会话等个性化设置)
model ConversationParticipant {
  id              String @id @default(cuid())
  conversation_id String
  user_id         String

  is_top     Boolean @default(false) // 是否置顶
  is_disturb Boolean @default(false) // 是否免打扰
  remark     String? // 针对该会话的备注（仅对自己生效）
  is_deleted Boolean @default(false) // 是否删除了该会话（软删除）

  update_time DateTime @updatedAt
  create_time DateTime @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id])
  user         User         @relation(fields: [user_id], references: [id])

  @@unique([conversation_id, user_id])
}

model MessageHistory {
  id              String @id @default(cuid())
  sender_id       String
  // 关联改为 Conversation，不再直接关联 Room
  conversation_id String

  content String  @db.Text
  type    Int // 0:文本, 1:图片, 2:文件, 3:音频, 4:视频
  is_read Boolean @default(false) // 建议改为 Boolean
  state   Int     @default(0) // -2:撤回, -1:删除, 0:正常, 1:编辑

  create_time DateTime @default(now())
  update_time DateTime @updatedAt

  user         User         @relation(fields: [sender_id], references: [id])
  conversation Conversation @relation(fields: [conversation_id], references: [id])

  // 核心索引：加载聊天记录必须
  @@index([conversation_id, create_time])
}

// ==========================================
// 5. 好友模块
// ==========================================
model Friend {
  id        String   @id @default(cuid())
  user_id   String
  friend_id String
  state     Int      @default(0) // 0: 正常, 1: 黑名单/拉黑, -1: 删除
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation("friendUser", fields: [user_id], references: [id])
  friend User @relation("friendFriend", fields: [friend_id], references: [id])

  @@unique([user_id, friend_id])
}

model FriendApply {
  id           String   @id @default(cuid())
  requester_id String
  responder_id String
  state        Int      @default(0) // 0: 待审核, 1: 已接受, -1: 已拒绝
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requester User @relation("friendApplyRequester", fields: [requester_id], references: [id])
  responder User @relation("friendApplyResponder", fields: [responder_id], references: [id])

  @@unique([requester_id, responder_id])
}
