// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique // 邮箱
  password        String // 密码
  phone           String?   @unique // 手机号
  nickname        String? // 昵称
  avatar_url      String? // 头像链接
  gender          Int // 性别 `0-女, 1-男, 2-其他`
  state           Int // 账号状态 `-1：注销, 0：正常`
  birthday        DateTime? // 生日
  signature       String? // 个性签名
  location        String? // 地区
  background_wall String? // 背景墙
  update_time     DateTime  @updatedAt // 更新时间
  create_time     DateTime  @default(now()) // 创建时间

  messages             MessageHistory[] // 消息记录
  chatRoomParticipants ChatRoomParticipant[] // 聊天室参与者

  friendUser           Friend[]      @relation("friendUser") // 作为用户的好友关系
  friendFriend         Friend[]      @relation("friendFriend")
  friendApplyRequester FriendApply[] @relation("friendApplyRequester")
  friendApplyResponder FriendApply[] @relation("friendApplyResponder")
}

model MessageHistory {
  id          String   @id @default(cuid())
  sender_id   String // 发送者唯一标识
  content     String // 聊天内容
  type        Int // 消息类型 `0：文本, 1：图片, 2：文件, 3：音频, 4：视频`
  is_read     Int // 是否已读 `0：未读, 1：已读`
  state       Int // 消息状态 `-2：已撤回, -1：已删除, 0：正常，1:已编辑`
  room_id     String? // 房间唯一标识
  update_time DateTime @updatedAt // 更新时间
  create_time DateTime @default(now()) // 创建时间

  user User @relation(fields: [sender_id], references: [id]) // 用户关系
}

model Friend {
  id        String   @id @default(cuid())
  user_id   String
  friend_id String
  state     Int      @default(0) // 0: 好友关系正常, 1: 等待、-1: 删除状态
  createdAt DateTime @default(now()) // 记录创建时间
  updatedAt DateTime @updatedAt // 记录更新时间

  user   User @relation("friendUser", fields: [user_id], references: [id])
  friend User @relation("friendFriend", fields: [friend_id], references: [id])

  @@unique([user_id, friend_id])
}

model ChatRoom {
  id          String   @id @default(cuid())
  room_name   String? // 房间名称
  type        Int // 聊天室类型 `0：私聊，1：群聊`
  state       Int // 聊天室状态 `-1：解散，0：正常`
  update_time DateTime @updatedAt // 更新时间
  create_time DateTime @default(now()) // 创建时间

  participants ChatRoomParticipant[] // 聊天室参与者
}

model ChatRoomParticipant {
  id            String   @id @default(cuid())
  room_id       String // 聊天室唯一标识
  user_id       String // 参与者唯一标识
  room_identity Int // 聊天室身份 `0：群主，1：管理员，2：普通成员`
  remarks       String? // 房间内备注名称
  state         Int // 参与者状态 `-1：退出，0：正常`
  update_time   DateTime @updatedAt // 更新时间
  create_time   DateTime @default(now()) // 创建时间

  room ChatRoom @relation(fields: [room_id], references: [id]) // 聊天室关系
  user User     @relation(fields: [user_id], references: [id]) // 用户关系
}

model FriendApply {
  id           String   @id @default(cuid())
  requester_id String // 申请人ID（用户A）
  responder_id String // 被申请人ID（用户B）
  state        Int      @default(0) // 0: 待审核, 1: 已接受, -1: 已拒绝
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requester User @relation("friendApplyRequester", fields: [requester_id], references: [id])
  responder User @relation("friendApplyResponder", fields: [responder_id], references: [id])

  @@unique([requester_id, responder_id])
}
